{
  "info": { "name": "TeamTaskManager — Uçtan Uca Kabul", "description": "Sırayla çalıştırın: admin login → kullanıcı → proje → üyelik → görev → güncelleme/filtre/durum → yorum/dosya → bildirim/dashboard → üye login ve 403.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
  "item": [
    { "name": "01 Health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('API sağlıklı', () => pm.response.to.have.status(200));"] } }] },
    { "name": "02 Hatalı giriş anlaşılır 401", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"yanlis-parola\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));", "pm.test('Anlaşılır mesaj', () => pm.expect(pm.response.json().message).to.include('hatalı'));"] } }] },
    { "name": "03 Admin login", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "const token=pm.response.json().data.accessToken; pm.environment.set('accessToken',token); pm.environment.set('adminToken',token);"] } }] },
    { "name": "04 Aktif ekip üyesi oluştur", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"firstName\":\"Demo\",\"lastName\":\"Üye\",\"email\":\"{{memberEmail}}\",\"password\":\"Member123!\",\"roles\":[\"TeamMember\"]}" }, "url": "{{baseUrl}}/api/users" }, "event": [{ "listen": "prerequest", "script": { "exec": ["pm.environment.set('memberEmail', `demo.member.${Date.now()}@teamtask.local`);"] } }, { "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));", "pm.environment.set('userId',pm.response.json().data.id);"] } }] },
    { "name": "05 Proje oluştur", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"name\":\"Kabul {{$timestamp}}\",\"description\":\"Postman uçtan uca test\",\"startDate\":\"2026-09-15\",\"targetEndDate\":\"2026-12-31\"}" }, "url": "{{baseUrl}}/api/projects" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));", "pm.environment.set('projectId',pm.response.json().data.id);"] } }] },
    { "name": "06 Aktif üyeyi projeye ekle", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"userId\":\"{{userId}}\",\"memberRole\":2}" }, "url": "{{baseUrl}}/api/projects/{{projectId}}/members" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }] },
    { "name": "07 Görevi proje üyesine ata", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"projectId\":{{projectId}},\"title\":\"Kabul testi görevi\",\"description\":\"Uçtan uca doğrulama\",\"assignedUserId\":\"{{userId}}\",\"priority\":3,\"startDate\":\"2026-09-15\",\"dueDate\":\"2026-12-20\"}" }, "url": "{{baseUrl}}/api/tasks" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));", "pm.environment.set('taskId',pm.response.json().data.id);"] } }] },
    { "name": "08 Görev detayını güncelle", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"title\":\"Güncellenen kabul görevi\",\"description\":\"PUT doğrulandı\",\"assignedUserId\":\"{{userId}}\",\"priority\":4,\"startDate\":\"2026-09-15\",\"dueDate\":\"2026-12-21\"}" }, "url": "{{baseUrl}}/api/tasks/{{taskId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }] },
    { "name": "09 Filtre + sayfalama + sıralama", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks?projectId={{projectId}}&priority=4&pageNumber=1&pageSize=10&sort=duedate:asc" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sayfalı sonuç', () => {pm.response.to.have.status(200); const d=pm.response.json().data; pm.expect(d.pageNumber).to.eql(1); pm.expect(d.pageSize).to.eql(10);});"] } }] },
    { "name": "10 Görev durumunu değiştir", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"status\":2}" }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }] },
    { "name": "11 Yorum ekle", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"content\":\"Postman kabul yorumu\"}" }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }] },
    { "name": "12 İzinli dosya ekle", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "docs/postman/test-upload.txt" }] }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/attachments" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }] },
    { "name": "13 Bildirimleri görüntüle", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications?pageSize=50" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }] },
    { "name": "14 Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 ve veri', () => {pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('object');});"] } }] },
    { "name": "15 Ekip üyesi login", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{memberEmail}}\",\"password\":\"Member123!\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.environment.set('accessToken',pm.response.json().data.accessToken);"] } }] },
    { "name": "16 Üye admin endpointinde 403", "request": { "method": "GET", "url": "{{baseUrl}}/api/users?pageSize=10" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }] },
    { "name": "17 Üye görevlerini görür", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/my?pageSize=10" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Atanan görev var', () => {pm.response.to.have.status(200); pm.expect(pm.response.json().data.items.length).to.be.above(0);});", "pm.environment.set('accessToken',pm.environment.get('adminToken'));"] } }] }
  ]
}
